    "runs": 1,
    "kind": "deploy_regression",
    "suspect_service_contains": "recommendation",
    "remediation_type": "code_fix",
    "expect_route": "code_fix_pr",
    "expect_fix_verified": true,
    "expect_changed_files_any_of": [
