# Claude Agent SDK auth (required)
ANTHROPIC_API_KEY=sk-ant-...

# Feishu custom-bot webhook (online_op / low-confidence cards). Optional: if unset, cards print to stdout.
FEISHU_WEBHOOK_URL=

# GitHub (code_fix path). Real open-source flow: the buggy `recommendation` service
# lives in a PUBLIC upstream repo; each user forks it and the Agent opens a
# cross-fork PR against upstream — no collaborator invite needed.
#   - GITHUB_TOKEN         : your Personal Access Token (scope: public_repo). Create at
#                            https://github.com/settings/tokens
#   - GITHUB_UPSTREAM_OWNER: owner of the shared upstream repo (the PR base). example default below.
#   - GITHUB_REPO          : the service repo name.
#   - GITHUB_FORK_OWNER    : YOUR github username (Agent clones/pushes here; PR head).
#                            Leave empty ONLY if you are the maintainer pushing to your own repo.
GITHUB_TOKEN=
GITHUB_UPSTREAM_OWNER=HuaiNan54321
GITHUB_REPO=recommendation
GITHUB_FORK_OWNER=
# GITHUB_DEFAULT_BRANCH=master
# GITHUB_API_BASE=https://api.github.com

# Observability endpoints (Agent1 reads these via curl)
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
FLAGD_OFREP_URL=http://localhost:8016

# --- Memory / RAG (Milvus vector store + local BGE embedding) ---
# Agent1 does agentic RAG over past diagnosis tickets via an in-process MCP tool.
AIOPS_RAG_ENABLED=1
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=aiops_tickets
# Local embedding model (offline, no API key). Download once via:
#   modelscope download BAAI/bge-small-zh-v1.5   (China-friendly; cached under ~/.cache/modelscope)
# memory.py auto-uses the ModelScope cache if present, else falls back to the HF repo id.
AIOPS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
RAG_TOP_K=5
# HuggingFace mirror (only needed if downloading via HF instead of ModelScope)
# HF_ENDPOINT=https://hf-mirror.com

# --- LLM backend (default: real Claude Opus via the claude CLI's own auth) ---
# To route the Agent at a locally-served fine-tuned model (vLLM, see
# deploy/switch_aiops_model.md in the aiops-agentic-rl repo), uncomment the block
# below. NOTE: config.py deliberately reads the AIOPS_LLM_* names (NOT the official
# ANTHROPIC_* ones) so that shell/company-tool "environment pollution" of
# ANTHROPIC_BASE_URL can't silently hijack the default branch — os.getenv's default
# only applies when the variable is completely absent. sdk_runner.py injects these
# into the claude CLI subprocess as the ANTHROPIC_* vars it actually reads.
# AIOPS_MODEL=aiops-qwen3.5-9b
# AIOPS_LLM_BASE_URL=http://localhost:8000
# AIOPS_LLM_API_KEY=placeholder-key
# AIOPS_LLM_AUTH_TOKEN=placeholder-token

# Routing / cost knobs (override config defaults)
# CONFIDENCE_THRESHOLD=0.6
# DEDUP_TTL_SECONDS=1800
# DIAGNOSE_MAX_TURNS=50
# DIAGNOSE_TIMEOUT_S=600
# FIX_MAX_TURNS=50
# FIX_TIMEOUT_S=900
# SCHEMA_RETRY_MAX=2

# --- Auto low-risk remediation (diagnose Agent can auto-execute a whitelist of low-risk ops) ---
# Master switch. Set 0 to revert the diagnose Agent to read-only (all online ops -> feishu card).
AIOPS_REMEDIATION_ENABLED=1
# Remediation backend: "docker" (local default, zero-setup) or "k8s" (production shape).
# AIOPS_BACKEND=docker
# AIOPS_K8S_NAMESPACE=otel-demo
# Finite allowlist of instances the Agent may auto restart/scale. Stateless business
# containers only — never stateful components (kafka/valkey/milvus/db). Comma-separated.
AIOPS_REMEDIATION_TARGETS=recommendation,ad,frontend,cart,checkout,currency,payment,shipping,quote,email
